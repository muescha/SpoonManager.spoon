{
  "command": {
    "action": "install",
    "from": {
      "type": "github-release",
      "url": "https://github.com/muescha/DeepFolder.spoon/releases/latest/download/latest.zip"
    },
    "name": "DeepFolder",
    "options": {
      "onLocalChanges": "abort"
    },
    "to": {
      "name": "DeepFolder",
      "path": "/tmp/hammerspoon-test/Spoons/DeepFolder.spoon",
      "type": "spoon"
    }
  },
  "config": {
    "source": {
      "baseUrl": "https://github.com",
      "provider": "github",
      "release_releaseLatest": true,
      "repository": "muescha/DeepFolder.spoon",
      "type": "github",
      "zipFile": "latest.zip"
    },
    "target": {
      "name_withName": "DeepFolder"
    }
  },
  "resolved": {
    "asset": "latest.zip",
    "installName": "DeepFolder",
    "release": "latest",
    "sourceType": "github-release",
    "url": "https://github.com/muescha/DeepFolder.spoon/releases/latest/download/latest.zip"
  }
}
