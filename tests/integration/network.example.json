{
  "version": 1,
  "cleanup": {
    "allTests": {
      "rootBeforeAllTests": true,
      "rootAfterAllTests": false
    },
    "test": {
      "installPathBeforeTest": true,
      "installPathAfterTest": false
    }
  },
  "pathTemplates": {
    "root": ".network-installs",
    "install": "{root}/{timestamp}/test/{id}",
    "explain": "{root}/{timestamp}/test/{id}/{id}.explain.json",
    "result": "{root}/{timestamp}/test/{id}/{id}.result.json",
    "log": "{root}/{timestamp}/test/{id}/{id}.log.json"
  },
  "tests": [
    {
      "id": "github-folder",
      "enabled": true,
      "description": "Install a Spoon from a folder inside a GitHub repository archive.",
      "source": {
        "type": "github-folder",
        "repository": "Hammerspoon/Spoons",
        "branch": "master",
        "folder": "Source/WindowSigils.spoon"
      },
      "target": {
        "name": "WindowSigils"
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "spoon-repo",
      "enabled": true,
      "description": "Install a named Spoon from a repository using Source/{name}.spoon.",
      "source": {
        "type": "spoon-repo",
        "repository": "Hammerspoon/Spoons",
        "branch": "master"
      },
      "target": {
        "spoon": "WindowSigils"
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "spoon-repo-zip",
      "enabled": true,
      "description": "Install a named Spoon from a repository using Spoons/{name}.spoon.zip.",
      "source": {
        "type": "spoon-repo-zip",
        "repository": "Hammerspoon/Spoons",
        "branch": "master"
      },
      "target": {
        "spoon": "WindowSigils"
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "github-repository",
      "enabled": true,
      "description": "Install a Spoon where the GitHub repository root is the Spoon root.",
      "source": {
        "type": "github-repository",
        "repository": "owner/TestSpoon.spoon",
        "branch": "main"
      },
      "target": {
        "name": "TestSpoon"
      },
      "expect": {
        "failure": {
          "messageContains": "HTTP status 404"
        }
      }
    },
    {
      "id": "github-release",
      "enabled": true,
      "description": "Install a Spoon from a GitHub release ZIP asset.",
      "source": {
        "type": "github-release",
        "repository": "owner/TestSpoon.spoon",
        "release": "latest",
        "asset": "TestSpoon.zip"
      },
      "target": {
        "name": "TestSpoon"
      },
      "expect": {
        "failure": {
          "messageContains": "HTTP status 404"
        }
      }
    },
    {
      "id": "remote-zip",
      "enabled": true,
      "description": "Install a Spoon from an arbitrary remote ZIP URL.",
      "source": {
        "type": "remote-zip",
        "url": "https://github.com/Hammerspoon/Spoons/raw/master/Spoons/WindowSigils.spoon.zip"
      },
      "target": {
        "name": "WindowSigils"
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "remote-zip-error",
      "enabled": true,
      "description": "Verify that a missing remote ZIP returns a structured failure.",
      "source": {
        "type": "remote-zip",
        "url": "https://example.com/TestSpoon.zip"
      },
      "target": {
        "name": "TestSpoon"
      },
      "expect": {
        "failure": {
          "messageContains": "HTTP status 404"
        }
      }
    }
  ]
}
