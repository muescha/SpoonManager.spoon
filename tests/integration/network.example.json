{
  "version": 1,
  "cleanup": {
    "allTests": {
      "rootBeforeAllTests": true,
      "rootAfterAllTests": false
    },
    "test": {
      "installPathBeforeTest": true,
      "installPathAfterTest": false
    }
  },
  "pathTemplates": {
    "root": ".network-installs",
    "install": "{root}/{timestamp}/test/{id}",
    "explain": "{root}/{timestamp}/test/{id}/{id}.explain.json",
    "result": "{root}/{timestamp}/test/{id}/{id}.result.json",
    "log": "{root}/{timestamp}/test/{id}/{id}.log.json"
  },
  "tests": [
    {
      "id": "github-folder",
      "enabled": true,
      "description": "Install a Spoon from a folder inside a GitHub repository archive.",
      "config": {
        "source": {
          "type": "github",
          "provider": "github",
          "repository": "Hammerspoon/Spoons",
          "baseUrl": "https://github.com",
          "revision_branch": "master"
        },
        "target": {
          "selection_folder": "Source/WindowSigils.spoon",
          "name_withName": "WindowSigils"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "spoon-repo",
      "enabled": true,
      "description": "Install a named Spoon from a repository using Source/{name}.spoon.",
      "config": {
        "source": {
          "type": "github",
          "provider": "github",
          "repository": "Hammerspoon/Spoons",
          "baseUrl": "https://github.com",
          "revision_branch": "master",
          "pattern_spoonFolderPattern": "Source/{name}.spoon"
        },
        "target": {
          "selection_spoon": "WindowSigils"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "spoon-repo-zip",
      "enabled": true,
      "description": "Install a named Spoon from a repository using Spoons/{name}.spoon.zip.",
      "config": {
        "source": {
          "type": "github",
          "provider": "github",
          "repository": "Hammerspoon/Spoons",
          "baseUrl": "https://github.com",
          "revision_branch": "master",
          "pattern_spoonZipPattern": "Spoons/{name}.spoon.zip"
        },
        "target": {
          "selection_spoon": "WindowSigils"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "github-repository",
      "enabled": true,
      "description": "Install a Spoon where the GitHub repository root is the Spoon root.",
      "config": {
        "source": {
          "type": "github",
          "provider": "github",
          "repository": "vruyr/hammerspoon-screensandwindows.spoon",
          "baseUrl": "https://github.com",
          "revision_branch": "main"
        },
        "target": {
          "name_withName": "ScreensAndWindows"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "github-release-latest",
      "enabled": true,
      "description": "Install a Spoon from the latest GitHub release ZIP asset.",
      "config": {
        "source": {
          "type": "github",
          "provider": "github",
          "repository": "fork-my-spoons/gitlab-merge-requests.spoon",
          "baseUrl": "https://github.com",
          "release_releaseLatest": true
        },
        "target": {
          "selection_asset": "gitlab-merge-requests.spoon.zip"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "github-release-ref",
      "enabled": true,
      "description": "Install a Spoon from a fixed GitHub release ZIP asset.",
      "config": {
        "source": {
          "type": "github",
          "provider": "github",
          "repository": "fork-my-spoons/gitlab-merge-requests.spoon",
          "baseUrl": "https://github.com",
          "release_release": "v1.1"
        },
        "target": {
          "selection_asset": "gitlab-merge-requests.spoon.zip"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "remoteZip",
      "enabled": true,
      "description": "Install a Spoon from an arbitrary remote ZIP URL.",
      "config": {
        "source": {
          "type": "remoteZip",
          "url": "https://github.com/Hammerspoon/Spoons/raw/master/Spoons/AutoMuteOnSleep.spoon.zip"
        }
      },
      "expect": {
        "files": [
          "init.lua"
        ]
      }
    },
    {
      "id": "remoteZip-error",
      "enabled": true,
      "description": "Verify that a missing remote ZIP returns a structured failure.",
      "config": {
        "source": {
          "type": "remoteZip",
          "url": "https://example.com/TestSpoon.zip"
        },
        "target": {
          "name_withName": "TestSpoon"
        }
      },
      "expect": {
        "failure": {
          "messageContains": "HTTP status 404"
        }
      }
    }
  ]
}
